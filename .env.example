# ======================================================
# Insurance Claim Management System — Environment Config
# ======================================================

# Groq Cloud AI API Key (Get your free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (options: openai/gpt-oss-120b, llama-3.3-70b-versatile, openai/gpt-oss-20b)
GROQ_API_MODEL=openai/gpt-oss-120b

# MySQL Configuration
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=insurance_db
MYSQL_PORT=3307
