# ======================================================
# Insurance Claim Management System — Environment Config
# ======================================================

# Groq Cloud AI API Key (Get your free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile)
GROQ_API_MODEL=llama-3.3-70b-versatile

# MySQL Configuration
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=insurance_db
